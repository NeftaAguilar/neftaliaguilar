# Buffer API — powers the publishing chart in the hero.
# Create a personal key at https://publish.buffer.com/settings/api
# Server-only: it is read in `lib/buffer.ts`, which is `server-only`.
# Without it the hero falls back to the @neftaliaguilar/ui showcase.
BUFFER_API_KEY=

# Optional. Defaults to the first organization on the account.
BUFFER_ORGANIZATION_ID=
